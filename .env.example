# 数据库
DATABASE_URL=postgres://atomlet:atomlet_dev_pw@localhost:55432/atomlet
POSTGRES_PASSWORD=atomlet_dev_pw

# 模型通道：mock = 本地确定性生成（无需 key，默认）
# 改成 openai 后填下面两项即可切到真实模型（DeepSeek / 通义 / 任意 OpenAI 兼容端点）
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 生成超时（毫秒）
GEN_TIMEOUT_MS=90000
